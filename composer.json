{
	"name": "idmarinas/common-bundle",
	"type": "symfony-bundle",
	"license": "BSD-3-Clause",
	"keywords": [
		"symfony-bundle",
		"settings-bundle",
		"settings"
	],
	"homepage": "https://github.com/idmarinas/common-bundle",
	"authors": [
		{
			"name": "Iván Diaz Marinas (IDMarinas)",
			"email": "35842929+idmarinas@users.noreply.github.com",
			"role": "Creator, Developer"
		}
	],
	"support": {
		"issues": "https://github.com/idmarinas/common-bundle/issues"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": "^8.1",
		"symfony/config": "^5.4 | ^6.4 | ^7.0",
		"symfony/console": "^5.4 | ^6.4 | ^7.0",
		"symfony/dependency-injection": "^5.4 | ^6.4 | ^7.0",
		"symfony/filesystem": "^5.4 | ^6.4 | ^7.0"
		"php": "^8.2",
		"symfony/dependency-injection": "^6.4 | ^7.0",
		"symfony/framework-bundle": "^6.4 | ^7.0"
	},
	"require-dev": {
		"doctrine/doctrine-bundle": "^2.13",
		"doctrine/orm": "^2.20",
		"easycorp/easyadmin-bundle": "^4.0",
		"fakerphp/faker": "^1.21",
		"gedmo/doctrine-extensions": "^3.17",
		"matthiasnoback/symfony-config-test": "^4.2 | ^5.0",
		"matthiasnoback/symfony-dependency-injection-test": "^4.2 | ^5.0 | ^6.0",
		"nyholm/symfony-bundle-test": "^2.0",
		"php-mock/php-mock-phpunit": "^2.10",
		"phpunit/phpunit": "^9.5",
		"rector/rector": "^1.2",
		"symfony/form": "^5.4 | ^6.4 | ^7.0",
		"symfony/framework-bundle": "^5.4 | ^6.4 | ^7.0",
		"symfony/phpunit-bridge": "^5.4",
		"symfony/test-pack": "^1.0",
		"symfony/validator": "^5.4 | ^6.4 | ^7.0"
	},
	"config": {
		"allow-plugins": {
			"composer/package-versions-deprecated": true,
			"idmarinas/composer-plugin": false,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"optimize-autoloader": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"autoload": {
		"psr-4": {
			"Idm\\Bundle\\Common\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\": "app/src/",
			"Idm\\Bundle\\Common\\Tests\\": "tests/",
			"DataFixtures\\": "fixtures/",
			"Factory\\": "factories/"
		}
	},
	"scripts": {
		"test:fixtures:load": [
			"php bin/console doctrine:schema:drop --env=test --force --ansi",
			"php bin/console doctrine:schema:update --env=test --force --complete --ansi",
			"php bin/console doctrine:fixtures:load --env=test -n --ansi"
		],
		"dev:fixtures:load": [
			"php bin/console doctrine:schema:drop --env=dev --force --ansi",
			"php bin/console doctrine:schema:update --env=dev --force --complete --ansi",
			"php bin/console doctrine:fixtures:load --env=dev -n --ansi"
		]
	},
	"funding": [
		{
			"type": "paypal",
			"url": "https://www.paypal.me/idmarinas"
		},
		{
			"type": "github-sponsors",
			"url": "https://github.com/sponsors/idmarinas"
		}
	]
}
