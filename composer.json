{
	"name": "idmarinas/common-bundle",
	"description": "This bundle is intended to group common and often repeated things when creating an APP with Symfony.",
	"type": "symfony-bundle",
	"license": "BSD-3-Clause",
	"keywords": [
		"symfony-bundle",
		"common-bundle",
		"common"
	],
	"homepage": "https://github.com/idmarinas/common-bundle",
	"authors": [
		{
			"name": "Iván Diaz Marinas (IDMarinas)",
			"email": "35842929+idmarinas@users.noreply.github.com",
			"role": "Author, Developer, Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/idmarinas/common-bundle/issues"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": "^8.3",
		"symfony/console": "^6.4 | ^7.1 | ^8.0",
		"symfony/dependency-injection": "^6.4 | ^7.1 | ^8.0",
		"symfony/form": "^6.4 | ^7.1 | ^8.0",
		"symfony/framework-bundle": "^6.4 | ^7.1 | ^8.0",
		"symfony/translation": "^6.4 | ^7.1 | ^8.0",
		"symfony/validator": "^6.4 | ^7.1 | ^8.0",
		"symfony/uid": "^6.4 | ^7.1 | ^8.0",
		"symfony/yaml": "^6.4 | ^7.1 | ^8.0"
	},
	"require-dev": {
		"dama/doctrine-test-bundle": "^8.2",
		"doctrine/doctrine-fixtures-bundle": "^3.0 | ^4.0",
		"easycorp/easyadmin-bundle": "^4.23",
		"idmarinas/composer-plugin": "^1.0",
		"php-mock/php-mock-phpunit": "^2.12",
		"phpunit/phpunit": "^12.5",
		"rector/rector": "^2.0",
		"stof/doctrine-extensions-bundle": "^1.13",
		"symfony/browser-kit": "^6.4 | ^7.1 | ^8.0",
		"symfony/css-selector": "^6.4 | ^7.1 | ^8.0",
		"symfony/maker-bundle": "^1.61",
		"symfony/runtime": "^6.4 | ^7.1 | ^8.0",
		"symfony/security-bundle": "^6.4 | ^7.1 | ^8.0",
		"symfony/twig-bundle": "^6.4 | ^7.1 | ^8.0",
		"zenstruck/foundry": "^2.3"
	},
	"replace": {
		"symfony/polyfill-php72": "*",
		"symfony/polyfill-php73": "*",
		"symfony/polyfill-php74": "*",
		"symfony/polyfill-php80": "*",
		"symfony/polyfill-php81": "*",
		"symfony/polyfill-php82": "*",
		"symfony/polyfill-php83": "*"
	},
	"autoload": {
		"psr-4": {
			"Idm\\Bundle\\Common\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\": "tests/app/src/",
			"Idm\\Bundle\\Common\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"fixtures:load": [
			"php bin/console doctrine:schema:drop --force --ansi",
			"php bin/console doctrine:schema:update --force --ansi",
			"php bin/console doctrine:fixtures:load -n --ansi"
		],
		"test:fixtures:load": "@composer fixtures:load -- --env=test",
		"dev:fixtures:load": "@composer fixtures:load -- --env=dev"
	},
	"config": {
		"allow-plugins": {
			"composer/package-versions-deprecated": true,
			"idmarinas/composer-plugin": true,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"optimize-autoloader": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"funding": [
		{
			"type": "paypal",
			"url": "https://www.paypal.me/idmarinas"
		},
		{
			"type": "github-sponsors",
			"url": "https://github.com/sponsors/idmarinas"
		}
	],
	"extra": {
		"thanks": {
			"name": "idmarinas/common-bundle",
			"url": "https://github.com/idmarinas/common-bundle"
		}
	}
}
